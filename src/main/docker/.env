# ===================================================================
# All4QMS Environment Variables
# Copy this file to .env and modify as needed
# ===================================================================

# Java Options
_JAVA_OPTIONS=-Xmx512m -Xms256m

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod,api-docs

# Management
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# JHipster Registry
jhipster.registry.password=admin
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://admin:$${jhipster.registry.password}@jhipster-registry:8761/eureka
SPRING_CLOUD_CONFIG_URI=http://admin:$${jhipster.registry.password}@jhipster-registry:8761/config

# Database URLs
SPRING_R2DBC_URL=r2dbc:postgresql://postgresql:5432/
SPRING_LIQUIBASE_URL=jdbc:postgresql://postgresql:5432/

# QMS Registry
QMS_REGISTRY_HOST=127.0.0.1:8761
QMS_REGISTRY_PROTOCOLO=http

# Gateway Configuration
GATEWAY_URL=http://127.0.0.1:9080
GATEWAY_HOST=127.0.0.1:9080
PROXY_PORT=3000

# IA Service
IA_HOST=http://127.0.0.1:27000
LLM_HOST=http://127.0.0.1:8889

# Server Communication
SERVER_GATEWAY=http://127.0.0.1:9081
SERVER_RNC=http://127.0.0.1:9082

# Sleep Times (in seconds)
JHIPSTER_SLEEP=30
RNC_SLEEP=40
INFODOC_SLEEP=50
RISCO_SLEEP=40
METAIND_SLEEP=50
AUDITPLAN_SLEEP=60

# Database Names
DB_GATEWAY=all4qmsMsGateway
DB_RNC=all4qmsnsrnc
DB_INFODOC=all4qmsmsinfodoc
DB_RISCO=all4qmsmsrisco
DB_METAIND=all4qmsmsmetaind
DB_AUDITPLAN=all4qmsmsauditplan

# Intervalo de consulta do serviço de resumo IA (em milissegundos)
INTERVALO_CONSULTA_RESUMO=60000
